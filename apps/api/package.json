{
  "name": "@vynema/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:build": "pnpm --filter @vynema/shared build && pnpm build",
    "db:backup": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js backup",
    "db:inspect": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js inspect",
    "db:migrate": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js migrate",
    "db:reset": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js reset",
    "db:restore": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js restore",
    "db:status": "pnpm db:build && node --env-file-if-exists=.env dist/src/cli/database.js status",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/src/server.js",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.9",
    "@vynema/shared": "workspace:*",
    "hono": "^4.12.34"
  }
}
